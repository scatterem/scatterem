__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/

# reconstruction outputs and downloaded data
*.png
*.npy
*.h5
!experiments/**/*.png

# The site's mark. Without these two exceptions the blanket *.png above silently
# drops them, and the navbar logo and favicon 404 on the published site -- which is
# exactly what happened once.
!logo.png
!favicon.png

# Quarto build artifacts. `docs/api.qmd` is generated from live docstrings by
# docs/_generate_api.py (the CI regenerates it on every build), so committing it
# would just be a copy that goes stale.
/.quarto/
/_site/
/docs/api.qmd
