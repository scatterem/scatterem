__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/

# the Sphinx build of the documentation site
_build/

# reconstruction outputs and downloaded data
*.png
*.npy
*.h5
!experiments/**/*.png
# the figure scripts write their outputs here
experiments/ff_stem/outputs/

# The site's mark. Without these two exceptions the blanket *.png above silently
# drops them, and the navbar logo and favicon 404 on the published site -- which is
# exactly what happened once.
!logo.png
!favicon.png

# The two images of the start page. Without this exception the blanket *.png
# above drops them, and the start page shows two broken images -- which is
# what happened to the first push of the book layout.
!docs/images/*.png
