cff-version: 1.2.0
message: If you use this software, please cite the paper it implements.
title: "scatterem: fused full-field STEM"
abstract: >-
  Direct (single-side-band) ptychography, tilt-corrected dark-field imaging, and
  their SSNR-weighted Wiener fusion for 4D-STEM data.
type: software
license: Apache-2.0
repository-code: "https://github.com/scatterem/scatterem"

# Authors of this software. The paper's full author list is under
# preferred-citation below.
authors:
  - family-names: You
    given-names: Shengbo
  - family-names: Pelz
    given-names: Philipp
    email: philipp.pelz@fau.de

preferred-citation:
